{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-4a5b-b6c7-d8e9f0a1b2c3",
		"name": "Melotix API",
		"description": "Bộ sưu tập API cho hệ thống đặt vé Melotix (Customer & Admin)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"User@123\",\n    \"fullName\": \"Nguyễn Văn A\"\n}",
							"options": { "照顾": { "language": "json" } }
						},
						"url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set(\"token\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@concert.vn\",\n    \"password\": \"Admin@123\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
					}
				}
			]
		},
		{
			"name": "Customer Flow",
			"item": [
				{
					"name": "List Concerts",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{base_url}}/concerts?page=1&limit=10", "host": ["{{base_url}}"], "path": ["concerts"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] }
					}
				},
				{
					"name": "Create Booking (Flash Sale Test)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"concertId\": \"ID_HERE\",\n    \"ticketTypeId\": \"ID_HERE\",\n    \"quantity\": 2,\n    \"voucherCode\": \"WELCOME2026\",\n    \"idempotencyKey\": \"unique-uuid-1234\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{base_url}}/bookings", "host": ["{{base_url}}"], "path": ["bookings"] }
					}
				}
			]
		},
		{
			"name": "Admin Operations",
			"item": [
				{
					"name": "Dashboard Stats",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
						],
						"url": { "raw": "{{base_url}}/operation/stats", "host": ["{{base_url}}"], "path": ["operation", "stats"] }
					}
				},
				{
					"name": "Admin - All Bookings",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
						],
						"url": { "raw": "{{base_url}}/operation/bookings?q=Nguyen", "host": ["{{base_url}}"], "path": ["operation", "bookings"], "query": [{ "key": "q", "value": "Nguyen" }] }
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8080/api" },
		{ "key": "token", "value": "" }
	]
}
